{
  "name": "word2html",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs --production",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:capabilities": "node scripts/capability-readiness-audit.mjs",
    "audit:capabilities:strict": "node scripts/capability-readiness-audit.mjs --strict",
    "create:deployment-secrets": "node scripts/create-deployment-secrets.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "verify:data-backup": "node scripts/verify-data-backup.mjs",
    "restore:data": "node scripts/restore-data.mjs",
    "upgrade:lesson-directory": "node scripts/upgrade-lesson-directory.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "verify:sqlite": "node scripts/verify-sqlite-migration.mjs",
    "promote:sqlite-runtime": "node scripts/promote-sqlite-runtime.mjs",
    "verify:sqlite-runtime": "node scripts/verify-sqlite-runtime.mjs",
    "export:sqlite-runtime": "node scripts/export-sqlite-runtime.mjs",
    "verify:sqlite-export": "node scripts/verify-sqlite-export.mjs",
    "rehearse:sqlite-cutover": "node scripts/rehearse-sqlite-cutover.mjs",
    "acceptance:sqlite-active": "node scripts/sqlite-active-http-acceptance.mjs",
    "acceptance:deployment": "node scripts/deployment-config-acceptance.mjs",
    "acceptance:container-recovery": "node scripts/container-recovery-acceptance.mjs",
    "acceptance:container-runtime": "node scripts/container-runtime-browser-acceptance.mjs",
    "acceptance:appearance": "node scripts/browser-appearance-acceptance.mjs",
    "acceptance:collision": "node scripts/browser-collision-acceptance.mjs",
    "acceptance:relation-curve": "node scripts/browser-relation-curve-acceptance.mjs",
    "acceptance:parametric-trace": "node scripts/browser-parametric-trace-acceptance.mjs",
    "acceptance:quadratic": "node scripts/browser-quadratic-acceptance.mjs",
    "acceptance:explicit-function": "node scripts/browser-explicit-function-acceptance.mjs",
    "acceptance:geometry-primitives": "node scripts/browser-geometry-primitives-acceptance.mjs",
    "acceptance:geometry-transform": "node scripts/browser-geometry-transform-acceptance.mjs",
    "acceptance:motion-point": "node scripts/browser-motion-point-acceptance.mjs",
    "acceptance:data-chart": "node scripts/browser-data-chart-acceptance.mjs",
    "acceptance:object-editor": "node scripts/browser-object-editor-acceptance.mjs",
    "acceptance:presets": "node scripts/browser-preset-acceptance.mjs",
    "acceptance:model-settings": "node scripts/browser-model-settings-acceptance.mjs",
    "acceptance:temporary-model-key": "node scripts/browser-temporary-model-access-acceptance.mjs",
    "acceptance:user-session": "node scripts/browser-user-session-acceptance.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
