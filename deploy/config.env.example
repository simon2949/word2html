# 复制为 deploy/config.env 后修改；该实际配置文件已被 .gitignore 排除。
WORD2HTML_DOMAIN=lesson.example.edu
WORD2HTML_HTTP_PORT=80
WORD2HTML_HTTPS_PORT=443
WORD2HTML_SECRETS_DIR=./deploy/secrets
# 推荐改为宿主机独立磁盘的绝对路径，例如 /srv/word2html/backups。
WORD2HTML_BACKUP_DIRECTORY=word2html-backups

WORD2HTML_MODEL_PROVIDER=MiniMax
WORD2HTML_MODEL_PROTOCOL=anthropic-compatible
WORD2HTML_MODEL_BASE_URL=https://api.minimaxi.com/anthropic
WORD2HTML_MODEL_MODEL=MiniMax-M3
WORD2HTML_MODEL_MAX_TOKENS=2048
WORD2HTML_MODEL_TIMEOUT_MS=120000
WORD2HTML_MODEL_TEMPERATURE=1
WORD2HTML_MODEL_INPUT_COST_PER_MILLION_USD=0
WORD2HTML_MODEL_OUTPUT_COST_PER_MILLION_USD=0

WORD2HTML_OPERATIONAL_EVENT_LIMIT=200
WORD2HTML_USER_DAILY_CALLS=20
WORD2HTML_USER_DAILY_TOKENS=100000
