{
  "format": "word2html.lesson-package",
  "formatVersion": "0.1",
  "kind": "lesson-plan",
  "apiVersion": "lesson-plan-1.4",
  "plan": {
    "schemaVersion": "0.1",
    "status": "matched",
    "subject": "physics",
    "topic": "两个独立单摆的周期比较",
    "templateId": "experiment.motion.point-2d",
    "parameterOverrides": {},
    "experimentSpec": {
      "durationExpression": "4*pi*sqrt(max(L1,L2)/g)",
      "xExpression": "0-2+L1*sin(theta1)",
      "yExpression": "0-L1*cos(theta1)",
      "bodyId": "pendulum1",
      "bodyLabel": "左摆球",
      "additionalBodies": [
        {
          "id": "pendulum2",
          "label": "右摆球",
          "xExpression": "2+L2*sin(theta2)",
          "yExpression": "0-L2*cos(theta2)"
        }
      ],
      "formula": "T = 2pi sqrt(L/g)",
      "conclusion": "小角度近似下，摆长越长周期越大，两个摆的参数可以独立比较。",
      "parameters": [
        {
          "id": "g",
          "label": "重力加速度",
          "value": 9.8,
          "min": 1,
          "max": 20,
          "step": 0.1
        },
        {
          "id": "L1",
          "label": "左摆长",
          "value": 1,
          "min": 0.3,
          "max": 3,
          "step": 0.1
        },
        {
          "id": "L2",
          "label": "右摆长",
          "value": 1.6,
          "min": 0.3,
          "max": 3,
          "step": 0.1
        },
        {
          "id": "theta01",
          "label": "左初始摆角",
          "value": 0.25,
          "min": 0.05,
          "max": 0.35,
          "step": 0.01
        },
        {
          "id": "theta02",
          "label": "右初始摆角",
          "value": 0.18,
          "min": 0.05,
          "max": 0.35,
          "step": 0.01
        }
      ],
      "metrics": [
        {
          "id": "theta1",
          "label": "左摆角",
          "expression": "theta01*cos(sqrt(g/L1)*t)",
          "unit": "rad"
        },
        {
          "id": "theta2",
          "label": "右摆角",
          "expression": "theta02*cos(sqrt(g/L2)*t)",
          "unit": "rad"
        }
      ],
      "vectors": [],
      "constraints": [
        {
          "id": "rope1",
          "label": "左摆绳",
          "type": "rope",
          "bodyId": "pendulum1",
          "anchorXExpression": "0-2",
          "anchorYExpression": "0",
          "restLengthExpression": "L1"
        },
        {
          "id": "rope2",
          "label": "右摆绳",
          "type": "rope",
          "bodyId": "pendulum2",
          "anchorXExpression": "2",
          "anchorYExpression": "0",
          "restLengthExpression": "L2"
        }
      ]
    },
    "reason": "用两个受绳长约束的质点比较单摆周期。"
  }
}
