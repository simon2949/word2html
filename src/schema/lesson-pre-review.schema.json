{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word2html.local/schemas/lesson-pre-review-0.1.json",
  "title": "LessonPreReview 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardVersion", "verdict", "summary", "issues", "manualReviewFocus"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "standardVersion": { "const": "0.1" },
    "verdict": { "enum": ["no-issues", "issues-found"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
    "issues": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "location", "finding", "suggestedAction"],
        "properties": {
          "category": {
            "enum": [
              "scientific-accuracy",
              "formula-unit-consistency",
              "parameter-boundary",
              "teaching-suitability",
              "interaction-clarity",
              "safety-privacy",
              "maintenance"
            ]
          },
          "severity": { "enum": ["warning", "error", "critical"] },
          "location": { "type": "string", "minLength": 1, "maxLength": 180 },
          "finding": { "type": "string", "minLength": 1, "maxLength": 400 },
          "suggestedAction": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "manualReviewFocus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
