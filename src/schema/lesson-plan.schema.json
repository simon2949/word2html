{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://word2html.local/schemas/lesson-plan-0.1.json",
  "title": "LessonPlan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "subject",
    "topic",
    "templateId",
    "parameterOverrides",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "status": { "enum": ["matched", "unsupported"] },
    "subject": { "enum": ["math", "physics", "chemistry", "geography"] },
    "topic": { "type": "string", "minLength": 1, "maxLength": 120 },
    "templateId": {
      "enum": ["math.conic.ellipse-focus-sum", "math.function.quadratic-vertex", "math.function.generic-2d", "math.curve.relation-2d", "math.geometry.primitives-2d", "math.data.chart-2d", "experiment.motion.point-2d", "physics.collision.discs-2d", "unsupported"]
    },
    "parameterOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "majorAxis": { "type": "number", "minimum": 1, "maximum": 40 },
        "minorAxis": { "type": "number", "minimum": 0.5, "maximum": 40 },
        "coefficientA": { "type": "number", "minimum": -3, "maximum": 3 },
        "vertexH": { "type": "number", "minimum": -8, "maximum": 8 },
        "vertexK": { "type": "number", "minimum": -6, "maximum": 6 }
      }
    },
    "functionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "formula", "xMin", "xMax", "parameters"],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_+*/^()., \\t-]+$"
        },
        "formula": { "type": "string", "minLength": 1, "maxLength": 160 },
        "xMin": { "type": "number", "minimum": -50, "maximum": 50 },
        "xMax": { "type": "number", "minimum": -50, "maximum": 50 },
        "parameters": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "value", "min", "max", "step"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "relationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "formula", "conclusion", "parameters", "xMin", "xMax", "yMin", "yMax"],
      "properties": {
        "mode": { "enum": ["parametric", "polar", "implicit"] },
        "formula": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "parameters": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/dynamicParameter" }
        },
        "xMin": { "type": "number", "minimum": -100, "maximum": 100 },
        "xMax": { "type": "number", "minimum": -100, "maximum": 100 },
        "yMin": { "type": "number", "minimum": -100, "maximum": 100 },
        "yMax": { "type": "number", "minimum": -100, "maximum": 100 },
        "variableMin": { "type": "number", "minimum": -100, "maximum": 100 },
        "variableMax": { "type": "number", "minimum": -100, "maximum": 100 },
        "xExpression": { "$ref": "#/$defs/expression" },
        "yExpression": { "$ref": "#/$defs/expression" },
        "radialExpression": { "$ref": "#/$defs/expression" },
        "implicitExpression": { "$ref": "#/$defs/expression" }
      }
    },
    "geometrySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "conclusion", "parameters", "points", "connections", "arcs", "polygons", "measurements"],
      "properties": {
        "formula": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "parameters": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/dynamicParameter" }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/geometryPoint" }
        },
        "connections": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind", "fromPointId", "toPointId"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "kind": { "enum": ["segment", "ray", "vector"] },
              "fromPointId": { "$ref": "#/$defs/dynamicId" },
              "toPointId": { "$ref": "#/$defs/dynamicId" }
            }
          }
        },
        "arcs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "centerPointId", "startPointId", "endPointId"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "centerPointId": { "$ref": "#/$defs/dynamicId" },
              "startPointId": { "$ref": "#/$defs/dynamicId" },
              "endPointId": { "$ref": "#/$defs/dynamicId" },
              "clockwise": { "type": "boolean" }
            }
          }
        },
        "polygons": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "pointIds"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "pointIds": {
                "type": "array", "minItems": 3, "maxItems": 12,
                "items": { "$ref": "#/$defs/dynamicId" }
              },
              "filled": { "type": "boolean" }
            }
          }
        },
        "measurements": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind", "pointIds", "unit"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "kind": { "enum": ["distance", "angle", "area", "expression"] },
              "pointIds": {
                "type": "array", "maxItems": 12,
                "items": { "$ref": "#/$defs/dynamicId" }
              },
              "expression": { "$ref": "#/$defs/expression" },
              "unit": { "type": "string", "maxLength": 16 }
            }
          }
        },
        "loci": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "pointId", "parameterId"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "pointId": { "$ref": "#/$defs/dynamicId" },
              "parameterId": { "$ref": "#/$defs/dynamicId" },
              "min": { "type": "number" },
              "max": { "type": "number" }
            }
          }
        }
      }
    },
    "experimentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationExpression", "xExpression", "yExpression", "formula", "conclusion", "parameters", "metrics", "vectors"],
      "properties": {
        "durationExpression": { "$ref": "#/$defs/expression" },
        "xExpression": { "$ref": "#/$defs/expression" },
        "yExpression": { "$ref": "#/$defs/expression" },
        "bodyId": { "$ref": "#/$defs/dynamicId" },
        "bodyLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "additionalBodies": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/dynamicBody" }
        },
        "formula": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "parameters": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/dynamicParameter" }
        },
        "metrics": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "expression", "unit"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "expression": { "$ref": "#/$defs/expression" },
              "unit": { "type": "string", "maxLength": 16 }
            }
          }
        },
        "vectors": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "xExpression", "yExpression", "scale", "unit"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "xExpression": { "$ref": "#/$defs/expression" },
              "yExpression": { "$ref": "#/$defs/expression" },
              "scale": { "type": "number", "minimum": 0.01, "maximum": 20 },
              "unit": { "type": "string", "minLength": 1, "maxLength": 16 },
              "bodyId": { "$ref": "#/$defs/dynamicId" },
              "display": { "enum": ["arrow", "distance"] },
              "labelMode": { "enum": ["full", "value"] }
            }
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "type", "bodyId", "anchorXExpression", "anchorYExpression", "restLengthExpression"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "type": { "enum": ["rope", "spring"] },
              "bodyId": { "$ref": "#/$defs/dynamicId" },
              "anchorXExpression": { "$ref": "#/$defs/expression" },
              "anchorYExpression": { "$ref": "#/$defs/expression" },
              "restLengthExpression": { "$ref": "#/$defs/expression" }
            }
          }
        }
      }
    },
    "collisionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationExpression", "gravityXExpression", "gravityYExpression", "restitutionExpression", "formula", "conclusion", "parameters", "bounds", "bodies"],
      "properties": {
        "durationExpression": { "$ref": "#/$defs/expression" },
        "gravityXExpression": { "$ref": "#/$defs/expression" },
        "gravityYExpression": { "$ref": "#/$defs/expression" },
        "restitutionExpression": { "$ref": "#/$defs/expression" },
        "formula": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "parameters": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/dynamicParameter" }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xMinExpression", "xMaxExpression", "yMinExpression", "yMaxExpression"],
          "properties": {
            "xMinExpression": { "$ref": "#/$defs/expression" },
            "xMaxExpression": { "$ref": "#/$defs/expression" },
            "yMinExpression": { "$ref": "#/$defs/expression" },
            "yMaxExpression": { "$ref": "#/$defs/expression" }
          }
        },
        "bodies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "xExpression", "yExpression", "vxExpression", "vyExpression", "radiusExpression", "massExpression"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "xExpression": { "$ref": "#/$defs/expression" },
              "yExpression": { "$ref": "#/$defs/expression" },
              "vxExpression": { "$ref": "#/$defs/expression" },
              "vyExpression": { "$ref": "#/$defs/expression" },
              "radiusExpression": { "$ref": "#/$defs/expression" },
              "massExpression": { "$ref": "#/$defs/expression" }
            }
          }
        }
      }
    },
    "dataChartSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "formula", "conclusion", "xLabel", "yLabel", "unit", "series"],
      "properties": {
        "mode": { "enum": ["table", "bar", "line", "scatter"] },
        "formula": { "type": "string", "minLength": 1, "maxLength": 200 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "xLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "yLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "unit": { "type": "string", "maxLength": 16 },
        "categories": {
          "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "series": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/dynamicId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "values": {
                "type": "array", "minItems": 1, "maxItems": 24,
                "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
              },
              "points": {
                "type": "array", "minItems": 1, "maxItems": 60,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
                    "y": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
  },
  "$defs": {
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_+*/^()., \\t-]+$"
    },
    "dynamicId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
    },
    "dynamicParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "min", "max", "step"],
      "properties": {
        "id": { "$ref": "#/$defs/dynamicId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "geometryPoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "xExpression", "yExpression"],
          "properties": {
            "id": { "$ref": "#/$defs/dynamicId" },
            "label": { "type": "string", "minLength": 1, "maxLength": 20 },
            "xExpression": { "$ref": "#/$defs/expression" },
            "yExpression": { "$ref": "#/$defs/expression" },
            "draggable": { "type": "boolean" },
            "constraint": { "$ref": "#/$defs/geometryConstraint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "construction"],
          "properties": {
            "id": { "$ref": "#/$defs/dynamicId" },
            "label": { "type": "string", "minLength": 1, "maxLength": 20 },
            "construction": { "$ref": "#/$defs/geometryConstruction" }
          }
        }
      ]
    },
    "geometryConstruction": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "pointAId", "pointBId"],
          "properties": {
            "kind": { "const": "midpoint" },
            "pointAId": { "$ref": "#/$defs/dynamicId" },
            "pointBId": { "$ref": "#/$defs/dynamicId" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sourcePointId", "dxExpression", "dyExpression"],
          "properties": {
            "kind": { "const": "translation" },
            "sourcePointId": { "$ref": "#/$defs/dynamicId" },
            "dxExpression": { "$ref": "#/$defs/expression" },
            "dyExpression": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sourcePointId", "centerPointId", "angleExpression"],
          "properties": {
            "kind": { "const": "rotation" },
            "sourcePointId": { "$ref": "#/$defs/dynamicId" },
            "centerPointId": { "$ref": "#/$defs/dynamicId" },
            "angleExpression": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sourcePointId", "linePointAId", "linePointBId"],
          "properties": {
            "kind": { "enum": ["reflection", "projection"] },
            "sourcePointId": { "$ref": "#/$defs/dynamicId" },
            "linePointAId": { "$ref": "#/$defs/dynamicId" },
            "linePointBId": { "$ref": "#/$defs/dynamicId" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "sourcePointId", "centerPointId", "scaleExpression"],
          "properties": {
            "kind": { "const": "dilation" },
            "sourcePointId": { "$ref": "#/$defs/dynamicId" },
            "centerPointId": { "$ref": "#/$defs/dynamicId" },
            "scaleExpression": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    },
    "geometryConstraint": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "pointAId", "pointBId"],
          "properties": {
            "kind": { "enum": ["line", "segment"] },
            "pointAId": { "$ref": "#/$defs/dynamicId" },
            "pointBId": { "$ref": "#/$defs/dynamicId" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "centerPointId", "radiusExpression"],
          "properties": {
            "kind": { "const": "circle" },
            "centerPointId": { "$ref": "#/$defs/dynamicId" },
            "radiusExpression": { "$ref": "#/$defs/expression" }
          }
        }
      ]
    },
    "dynamicBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "xExpression", "yExpression"],
      "properties": {
        "id": { "$ref": "#/$defs/dynamicId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "xExpression": { "$ref": "#/$defs/expression" },
        "yExpression": { "$ref": "#/$defs/expression" }
      }
    }
  }
}
