# MiniMax-M3 非敏感配置示例。API Key 只从操作系统进程环境读取，不写入本文件。
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=1024
MINIMAX_TIMEOUT_MS=120000
MINIMAX_TEMPERATURE=1

# 本地服务监听地址。
HOST=127.0.0.1
PORT=5173

# 通常保持同源默认值即可。仅在模型代理部署到其他路径时覆盖。
VITE_SCENE_GENERATION_ENDPOINT=/api/generate
VITE_MODEL_STATUS_ENDPOINT=/api/health
