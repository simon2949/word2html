# 统一模型提供商的非敏感配置。API Key 只从操作系统进程环境读取，不写入本文件。
# MiniMax 仍是默认配置；也可改为 openai-compatible 和对应的 HTTPS Base URL。
WORD2HTML_MODEL_PROVIDER=MiniMax
WORD2HTML_MODEL_PROTOCOL=anthropic-compatible
WORD2HTML_MODEL_BASE_URL=https://api.minimaxi.com/anthropic
WORD2HTML_MODEL_MODEL=MiniMax-M3
WORD2HTML_MODEL_MAX_TOKENS=2048
WORD2HTML_MODEL_TIMEOUT_MS=120000
WORD2HTML_MODEL_TEMPERATURE=1
# 可选：用于管理员页面估算平台费用；单位为美元/百万 token。
WORD2HTML_MODEL_INPUT_COST_PER_MILLION_USD=0
WORD2HTML_MODEL_OUTPUT_COST_PER_MILLION_USD=0

# AI 预审可覆盖独立模型档案；未设置的字段继承生成模型。
WORD2HTML_REVIEW_MODEL_MAX_TOKENS=1600

# 旧 MINIMAX_BASE_URL / MODEL / MAX_TOKENS / REVIEW_MAX_TOKENS / TIMEOUT_MS /
# TEMPERATURE 环境变量仍然兼容，但统一 WORD2HTML_* 配置优先。
# 生产容器可用对应的 *_FILE 指向只读密钥文件；直接环境变量存在时优先。
# WORD2HTML_MODEL_API_KEY_FILE=/run/secrets/model-api-key

# 多模型公开部署可通过 WORD2HTML_MODEL_CATALOG_JSON 声明可信目录。
# 目录只填 apiKeyEnv 环境变量名，不填密钥值；详见 docs/model-provider-configuration.md。
WORD2HTML_MODEL_SETTINGS_FILE=.word2html-data/model-settings.json

# 模型调用防滥用与每日熔断。以下均为单实例内存计数，生产多实例需迁移 Redis。
WORD2HTML_MODEL_RATE_WINDOW_MS=600000
WORD2HTML_MODEL_RATE_GENERATION=8
WORD2HTML_MODEL_RATE_EDIT=12
WORD2HTML_MODEL_RATE_CORRECTION=8
WORD2HTML_MODEL_RATE_PRE_REVIEW=20
WORD2HTML_MODEL_RATE_CONNECTION_TEST=10
WORD2HTML_MODEL_CLIENT_CONCURRENCY=1
WORD2HTML_MODEL_GLOBAL_CONCURRENCY=4
WORD2HTML_MODEL_CLIENT_DAILY_CALLS=50
WORD2HTML_MODEL_PLATFORM_DAILY_CALLS=1000
WORD2HTML_MODEL_CLIENT_DAILY_TOKENS=250000
WORD2HTML_MODEL_PLATFORM_DAILY_TOKENS=5000000
# 0 表示暂不启用费用熔断；启用前应先配置每个模型的估算价格。
WORD2HTML_MODEL_PLATFORM_DAILY_COST_USD=0
WORD2HTML_MODEL_IDEMPOTENCY_TTL_MS=300000
# 建议生产环境单独注入随机值；不应使用 VITE_ 前缀。
# WORD2HTML_MODEL_USAGE_HASH_SECRET=
# WORD2HTML_MODEL_USAGE_HASH_SECRET_FILE=/run/secrets/model-usage-hash-secret

# 轻量用户目录和默认平台模型额度。登录码原文只在管理员签发时显示一次；
# 用户目录只保存其 SHA-256 摘要。会话密钥应从生产操作系统环境单独注入，
# 不要使用 VITE_ 前缀，也不要把真实密钥写入此文件。
WORD2HTML_USER_DIRECTORY_FILE=.word2html-data/users.json
WORD2HTML_USER_DAILY_CALLS=20
WORD2HTML_USER_DAILY_TOKENS=100000
# WORD2HTML_USER_SESSION_SECRET=
# WORD2HTML_USER_SESSION_SECRET_FILE=/run/secrets/user-session-secret

# 本地服务监听地址。
HOST=127.0.0.1
PORT=5173
# 数据恢复期间设为 true，会让就绪探针返回 503 并阻止全部 API 写操作。
WORD2HTML_MAINTENANCE_MODE=false
# 仅当应用端口不公开且请求必经可信单层反向代理时设为 true。
WORD2HTML_TRUST_PROXY=false
# 结构化运行事件只在进程内存保留有限条数；日志仍逐行输出到 stdout/stderr。
WORD2HTML_OPERATIONAL_EVENT_LIMIT=200
# 主存储默认且当前生产推荐为 json。SQLite 维护试运行只需设置 runtime 文件并开启维护模式。
WORD2HTML_STORAGE_BACKEND=json
# WORD2HTML_SQLITE_RUNTIME_FILE=.word2html-migrations/current-runtime-candidate.sqlite
# 单实例 active 模式需要同时明确设置以下两项；切换前必须完成备份、演练和回退准备。
# WORD2HTML_SQLITE_MODE=active-single-instance
# WORD2HTML_SQLITE_ACTIVATION_CONFIRM=confirm-single-instance-sqlite-writes
# 可选：只读 SQLite 影子数据库。启用后管理员页面比较 JSON 与 SQLite，仍由 JSON 负责全部写入。
# WORD2HTML_SQLITE_SHADOW_FILE=.word2html-migrations/shadow.sqlite

# 通常保持同源默认值即可。仅在模型代理部署到其他路径时覆盖。
VITE_SCENE_GENERATION_ENDPOINT=/api/generate
VITE_MODEL_STATUS_ENDPOINT=/api/health

# 共享实验目录的非敏感路径配置。管理员令牌只从操作系统
# WORD2HTML_ADMIN_TOKEN 读取，不写入本文件或任何 VITE_ 变量。
# WORD2HTML_ADMIN_TOKEN_FILE=/run/secrets/admin-token
WORD2HTML_LIBRARY_FILE=.word2html-data/lesson-directory.json
WORD2HTML_CAPABILITY_REVIEWS_FILE=.word2html-data/capability-subject-reviews.json
WORD2HTML_SUBMISSION_LIMIT=20
# 仅在生产环境通过 HTTPS 提供服务时设为 true。
WORD2HTML_SECURE_COOKIES=false
VITE_SHARED_LIBRARY_ENDPOINT=/api/library
